# ---------------------------------------------------------------------------
# Basis
# ---------------------------------------------------------------------------
# Öffentliche Adresse der Website. Wird für Links in E-Mails und die Sitemap
# gebraucht – ohne abschließenden Schrägstrich.
NEXT_PUBLIC_SITE_URL="https://www.trockenbau-berger.de"

# ---------------------------------------------------------------------------
# Google Kalender (Service Account)
# ---------------------------------------------------------------------------
# 1. console.cloud.google.com -> Projekt anlegen -> "Google Calendar API" aktivieren
# 2. IAM -> Dienstkonten -> Dienstkonto erstellen -> Schlüssel (JSON) herunterladen
# 3. In Google Kalender den Zielkalender für die Dienstkonto-E-Mail freigeben,
#    Berechtigung: "Änderungen an Terminen vornehmen"
GOOGLE_SERVICE_ACCOUNT_EMAIL="terminbuchung@projekt-id.iam.gserviceaccount.com"
# Privater Schlüssel aus der JSON-Datei, Zeilenumbrüche als \n, alles in Anführungszeichen.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# Die Kalender-ID steht in den Kalendereinstellungen. Bei einem persönlichen
# Kalender ist das die E-Mail-Adresse des Kontos.
GOOGLE_CALENDAR_ID="termine@trockenbau-berger.de"

# ---------------------------------------------------------------------------
# E-Mail-Versand (Resend)
# ---------------------------------------------------------------------------
# resend.com -> Domain verifizieren (SPF/DKIM per DNS) -> API-Key erzeugen.
# Ohne verifizierte Domain landen Bestätigungsmails im Spam.
RESEND_API_KEY="re_..."
MAIL_FROM="Trockenbau Berger <termine@trockenbau-berger.de>"
# Wohin die Anfragen mit den Zusagen-/Absagen-Buttons gehen.
MAIL_TO_OWNER="buero@trockenbau-berger.de"

# ---------------------------------------------------------------------------
# Sicherheit
# ---------------------------------------------------------------------------
# Signiert die Freigabe-Links in der Benachrichtigungsmail. Mindestens 24 Zeichen.
# Erzeugen mit:  openssl rand -base64 32
BOOKING_TOKEN_SECRET="hier-einen-langen-zufallswert-eintragen"
